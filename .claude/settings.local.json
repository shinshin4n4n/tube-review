{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "WebFetch(*)",
      "WebSearch",
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(gh *)",
      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(mkdir *)",
      "Bash(rm *)",
      "Bash(cd *)",
      "Bash(echo *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sed *)",
      "Bash(sort *)",
      "Bash(diff *)",
      "Bash(export:*)",
      "Bash(touch *)",
      "Bash(chmod *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(node *)",
      "Bash(pwd)",
      "Bash(whoami)",
      "Bash(which *)",
      "Bash(bash .claude/hooks/check-diff-threshold.sh)",
      "Bash(CLAUDE_TOOL_INPUT=\"npm run test\" bash .claude/hooks/notify-review-after-pr.sh)",
      "Bash(cd:*)",
      "Bash(sed -i 's/ \\(95\\\\/100\\)//' docs/SECURITY_AUDIT.md)",
      "Bash(sed -i 's/ \\(100\\\\/100\\)//' docs/SECURITY_AUDIT.md)",
      "Bash(sed -i 's/ \\(90\\\\/100\\)//' docs/SECURITY_AUDIT.md)",
      "Bash(sed -i '/\\\\*\\\\*スコア理由\\\\*\\\\*/d' docs/SECURITY_AUDIT.md)",
      "Bash(mv /tmp/queries-trimmed.ts app/_actions/list-channel-queries.ts)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(curl * | bash)",
      "Bash(sudo *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/check-diff-threshold.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/notify-review-after-pr.sh"
          }
        ]
      }
    ]
  }
}
